#!/usr/bin/env bash
# hosaka — thin desktop client.
#
# Wraps `docker run` to give you:
#   - a local hosaka node (web UI + TUI) on this machine, OR
#   - a remote-linked client that opens the browser against
#     another hosaka machine on your tailnet.
#
# Config lives in $HOSAKA_HOME (default: ~/.hosaka).
# State persists across restarts via a bind-mount at $HOSAKA_HOME/state.
#
# Subcommands:
#   hosaka up                  start the local node (detached)
#   hosaka down                stop the local node
#   hosaka tui                 drop into the console TUI
#                              inside the local container, not the host shell
#   hosaka configure llm ...   hidden API-key and provider setup
#   hosaka secrets <verb>      manage container credentials
#   hosaka picoclaw <args>     configure the container's PicoClaw runtime
#   hosaka workspace PATH [--read-write] share a folder at /workspace (default read-only)
#   hosaka workspace clear     return to the private container workspace
#   hosaka open                open the web UI in your browser
#   hosaka logs                follow logs from the local node
#   hosaka shell               bash shell inside the local container
#   hosaka status              what's running + where it points
#   hosaka update              pull the latest image
#   hosaka link <host[:port]>  route open/status at a remote hosaka
#   hosaka unlink              go back to using the local node
#   hosaka uninstall           remove launcher + local container (keeps state)
#   hosaka version             print versions
#   hosaka help                this message
#
# Env overrides:
#   HOSAKA_IMAGE         container image (default: ghcr.io/barkbarkbarkbarkbarkbarkbark/hosaka:latest)
#   HOSAKA_PORT          local port for the web UI (default: 8421)
#   HOSAKA_HOME          config + state dir (default: ~/.hosaka)
#   HOSAKA_CONTAINER     container name (default: hosaka)

set -euo pipefail

HOSAKA_IMAGE="${HOSAKA_IMAGE:-ghcr.io/barkbarkbarkbarkbarkbarkbark/hosaka:latest}"
HOSAKA_PORT="${HOSAKA_PORT:-8421}"
HOSAKA_HOME="${HOSAKA_HOME:-$HOME/.hosaka}"
HOSAKA_CONTAINER="${HOSAKA_CONTAINER:-hosaka}"
STATE_DIR="$HOSAKA_HOME/state"
LINK_FILE="$HOSAKA_HOME/link"
ENV_FILE="$HOSAKA_HOME/env"
WORKSPACE_FILE="$HOSAKA_HOME/workspace.conf"
PYTHON_BIN=/opt/hosaka-field-terminal/.venv/bin/python

mkdir -p "$HOSAKA_HOME" "$STATE_DIR" "$HOSAKA_HOME/runtime" "$HOSAKA_HOME/picoclaw" "$HOSAKA_HOME/workspace"

# ── style ────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
    C_DIM=$'\033[2m'; C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'
    C_AMBER=$'\033[33m'; C_RED=$'\033[31m'; C_RESET=$'\033[0m'
else
    C_DIM=""; C_CYAN=""; C_GREEN=""; C_AMBER=""; C_RED=""; C_RESET=""
fi
note() { printf '  %s›%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_AMBER" "$C_RESET" "$*"; }
die()  { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

# ── helpers ──────────────────────────────────────────────────────────────────
have_docker() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

image_id_for_ref() {
    local ref="$1"
    docker image inspect "$ref" --format '{{.Id}}' 2>/dev/null || true
}

container_image_id() {
    docker inspect "$HOSAKA_CONTAINER" --format '{{.Image}}' 2>/dev/null || true
}

image_digest_for_ref() {
    docker image inspect "$ref" --format '{{index .RepoDigests 0}}' 2>/dev/null || true
}

current_link() {
    [ -f "$LINK_FILE" ] && tr -d '[:space:]' < "$LINK_FILE"
}

# Normalize "host", "host:port", "http://host:port" → "http://host:port"
link_url() {
    local raw="$1"
    case "$raw" in
        http://*|https://*) printf '%s\n' "${raw%/}" ;;
        *:[0-9]*)           printf 'http://%s\n' "$raw" ;;
        *)                  printf 'http://%s:%s\n' "$raw" "$HOSAKA_PORT" ;;
    esac
}

runtime_args() {
    local workspace="$HOSAKA_HOME/workspace" mode=rw
    if [[ -f "$WORKSPACE_FILE" ]]; then
        { IFS= read -r workspace; IFS= read -r mode; } <"$WORKSPACE_FILE"
        [[ "$mode" == ro || "$mode" == rw ]] || die "invalid workspace mode; run hosaka workspace clear"
        [[ "$workspace" == /* && -d "$workspace" ]] || die "shared workspace is missing: $workspace"
    fi
    [[ "$workspace" != *','* && "$HOSAKA_HOME" != *','* ]] || die "Docker mount paths cannot contain commas"
    local mount="type=bind,src=$workspace,dst=/workspace"
    [[ "$mode" != ro ]] || mount="$mount,readonly"
    CONTAINER_ARGS=(
        --mount "type=bind,src=$STATE_DIR,dst=/var/lib/hosaka"
        --mount "type=bind,src=$HOSAKA_HOME/runtime,dst=/root/.hosaka"
        --mount "type=bind,src=$HOSAKA_HOME/picoclaw,dst=/root/.picoclaw"
        --mount "$mount"
        --workdir /workspace
        -e PYTHONPATH=/opt/hosaka-field-terminal
        -e HOSAKA_PROJECT_DIR=/workspace
    )
    [[ ! -f "$ENV_FILE" ]] || CONTAINER_ARGS+=(--env-file "$ENV_FILE")
}

tty_args() {
    TTY_ARGS=(-i)
    [[ ! -t 0 || ! -t 1 ]] || TTY_ARGS+=(-t)
}

initialize_runtime() {
    docker run --rm "${CONTAINER_ARGS[@]}" --entrypoint "$PYTHON_BIN" "$HOSAKA_IMAGE" \
        /opt/hosaka-field-terminal/scripts/bootstrap_picoclaw_runtime.py --home /root --seed-config >/dev/null
}

run_local() {
    have_docker || die "docker not running"
    tty_args
    if container_running; then
        exec docker exec "${TTY_ARGS[@]}" --workdir /workspace \
            -e PYTHONPATH=/opt/hosaka-field-terminal -e HOSAKA_PROJECT_DIR=/workspace "$HOSAKA_CONTAINER" "$@"
    fi
    runtime_args
    initialize_runtime
    exec docker run --rm "${TTY_ARGS[@]}" "${CONTAINER_ARGS[@]}" \
        --entrypoint "$1" "$HOSAKA_IMAGE" "${@:2}"
}

cmd_workspace() {
    [[ $# -gt 0 ]] || { if [[ -f "$WORKSPACE_FILE" ]]; then cat "$WORKSPACE_FILE"; else echo "$HOSAKA_HOME/workspace (private, read-write)"; fi; return; }
    container_running && die "stop the node with hosaka down before changing workspace mounts"
    if [[ "$1" == clear ]]; then
        [[ $# == 1 ]] || die "usage: hosaka workspace clear"
        rm -f "$WORKSPACE_FILE"
        ok "using the private workspace"
        return
    fi
    [[ $# == 1 || ( $# == 2 && "$2" == --read-write ) ]] || die "usage: hosaka workspace PATH [--read-write]"
    [[ -d "$1" ]] || die "workspace must be an existing directory"
    local path mode=ro
    path="$(cd "$1" && pwd -P)"
    [[ "$path" != *','* && "$path" != *$'\n'* ]] || die "workspace paths cannot contain commas or newlines"
    [[ $# == 1 ]] || mode=rw
    printf '%s\n%s\n' "$path" "$mode" >"$WORKSPACE_FILE"
    chmod 600 "$WORKSPACE_FILE"
    ok "sharing $path at /workspace ($mode)"
    note "Only this folder is shared; symlink targets outside it are not exposed."
}

container_running() {
    have_docker || return 1
    [ "$(docker inspect -f '{{.State.Running}}' "$HOSAKA_CONTAINER" 2>/dev/null || true)" = "true" ]
}

# ── commands ─────────────────────────────────────────────────────────────────
cmd_up() {
    have_docker || die "docker not running — start Docker Desktop or the docker daemon"
    if container_running; then
        ok "hosaka already running at http://127.0.0.1:$HOSAKA_PORT"
        printf '    launcher : %s\n' "$(realpath "$0")"
        printf '    state    : %s\n' "$STATE_DIR"
        return 0
    fi
    docker rm -f "$HOSAKA_CONTAINER" >/dev/null 2>&1 || true
    note "starting local node → http://127.0.0.1:$HOSAKA_PORT"
    runtime_args
    initialize_runtime
    docker run -d --rm \
        --name "$HOSAKA_CONTAINER" \
        -p "127.0.0.1:$HOSAKA_PORT:8421" \
        "${CONTAINER_ARGS[@]}" \
        -e HOSAKA_BOOT_MODE=headless \
        -e HOSAKA_DESKTOP_MODE=1 \
        "$HOSAKA_IMAGE" >/dev/null
    ok "up -> http://127.0.0.1:$HOSAKA_PORT"
    printf '    launcher : %s\n' "$(realpath "$0")" 
    printf '    state    : %s\n' "$STATE_DIR"
    printf '    image    : %s\n' "$HOSAKA_IMAGE"
    printf '    try      : hosaka open  |  hosaka tui\n'
}

cmd_down() {
    have_docker || die "docker not available"
    if container_running; then
        docker stop "$HOSAKA_CONTAINER" >/dev/null
        ok "stopped"
    else
        note "already down"
    fi
}

cmd_tui() {
    [[ -z "$(current_link || true)" ]] || die "remote native TUI requires SSH; run hosaka unlink to use the local container"
    run_local "$PYTHON_BIN" -m hosaka tui "$@"
}

cmd_configure() {
    [[ "${1:-}" == llm ]] || die "usage: hosaka configure llm --provider PROVIDER --model MODEL"
    shift
    run_local "$PYTHON_BIN" -m hosaka.llm_setup "$@"
}

cmd_secrets() {
    [[ $# -gt 0 ]] || set -- list
    case "$1" in
        set|unset|import-picoclaw) set -- "$@" --no-mirror ;;
    esac
    run_local "$PYTHON_BIN" -m hosaka.secrets "$@"
}

cmd_open() {
    local link url
    link="$(current_link || true)"
    if [ -n "$link" ]; then
        url="$(link_url "$link")"
    else
        container_running || { warn "local node not running. starting it."; cmd_up; }
        url="http://127.0.0.1:$HOSAKA_PORT"
    fi
    note "opening $url"
    if command -v open >/dev/null 2>&1; then open "$url"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"
    else printf '  visit: %s\n' "$url"; fi
}

cmd_logs() {
    container_running || die "local node not running"
    exec docker logs -f "$HOSAKA_CONTAINER"
}

cmd_shell() {
    run_local bash
}

cmd_status() {
    printf '\n'
    printf '  %shosaka%s\n' "$C_CYAN" "$C_RESET"
    printf '    image       : %s\n' "$HOSAKA_IMAGE"
    printf '    state dir   : %s\n' "$STATE_DIR"
    printf '    workspace   : '; cmd_workspace
    printf '    local node  : '
    if container_running; then
        printf '%srunning%s at http://127.0.0.1:%s\n' "$C_GREEN" "$C_RESET" "$HOSAKA_PORT"
    else
        printf '%sstopped%s\n' "$C_DIM" "$C_RESET"
    fi
    local link
    link="$(current_link || true)"
    if [ -n "$link" ]; then
        printf '    linked to   : %s%s%s  %s(remote)%s\n' "$C_AMBER" "$(link_url "$link")" "$C_RESET" "$C_DIM" "$C_RESET"
    else
        printf '    linked to   : %s(not linked — using local)%s\n' "$C_DIM" "$C_RESET"
    fi
    if command -v tailscale >/dev/null 2>&1; then
        local ts_status
        ts_status="$(tailscale status --self=false 2>/dev/null | head -5 || true)"
        if [ -n "$ts_status" ]; then
            printf '    tailnet     :\n'
            printf '%s\n' "$ts_status" | sed 's/^/      /'
        fi
    fi
    printf '\n'
}

cmd_update() {
    have_docker || die "docker not available"
    local before_local before_running after_local after_digest
    before_local="$(image_id_for_ref "$HOSAKA_IMAGE")"
    before_running="$(container_image_id)"

    note "checking latest image for $HOSAKA_IMAGE"
    docker pull "$HOSAKA_IMAGE"

    after_local="$(image_id_for_ref "$HOSAKA_IMAGE")"
    after_digest="$(image_digest_for_ref "$HOSAKA_IMAGE")"

    if [ -n "$after_digest" ]; then
        note "latest digest: $after_digest"
    fi

    if [ -n "$before_local" ] && [ "$before_local" = "$after_local" ]; then
        ok "image already current"
        if container_running; then
            ok "running node already matches local image"
        fi
        return 0
    fi

    if container_running; then
        if [ -n "$before_running" ] && [ "$before_running" = "$after_local" ]; then
            ok "local cache refreshed; running node already on newest image"
            return 0
        fi
        note "deploying newest image to local node"
        cmd_down
        cmd_up
    else
        note "newest image downloaded; start it with: hosaka up"
    fi
    ok "updated to newest image"
}

cmd_link() {
    local host="${1:-}"
    [ -z "$host" ] && die "usage: hosaka link <host[:port]>"
    printf '%s\n' "$host" > "$LINK_FILE"
    ok "linked to $(link_url "$host")"
    note "hosaka tui / hosaka open now target the remote"
    note "run 'hosaka unlink' to go back to local"
}

cmd_unlink() {
    if [ -f "$LINK_FILE" ]; then
        rm -f "$LINK_FILE"
        ok "unlinked — back to local node"
    else
        note "not linked"
    fi
}

cmd_uninstall() {
    warn "uninstalling hosaka launcher"
    if container_running; then docker stop "$HOSAKA_CONTAINER" >/dev/null 2>&1 || true; fi
    docker rm -f "$HOSAKA_CONTAINER" >/dev/null 2>&1 || true
    local self; self="$(command -v hosaka || true)"
    if [ -n "$self" ] && [ -w "$self" ]; then
        rm -f "$self" && ok "removed $self"
    elif [ -n "$self" ]; then
        sudo rm -f "$self" && ok "removed $self"
    fi
    note "state kept at $HOSAKA_HOME (delete manually if you want a clean slate)"
}

cmd_version() {
    printf 'hosaka launcher : %s\n' "0.1.0"
    printf 'image           : %s\n' "$HOSAKA_IMAGE"
    if have_docker; then
        docker image inspect "$HOSAKA_IMAGE" --format 'image digest    : {{index .RepoDigests 0}}' 2>/dev/null || true
    fi
}

cmd_help() {
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
}

# ── dispatch ─────────────────────────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
    up)         cmd_up ;;
    down|stop)  cmd_down ;;
    tui|console)cmd_tui "$@" ;;
    configure)  cmd_configure "$@" ;;
    secrets)    cmd_secrets "$@" ;;
    picoclaw)   run_local /usr/local/bin/picoclaw "$@" ;;
    workspace)  cmd_workspace "$@" ;;
    open)       cmd_open ;;
    logs)       cmd_logs ;;
    shell|sh)   cmd_shell ;;
    status|st)  cmd_status ;;
    update|pull)cmd_update ;;
    link)       cmd_link "$@" ;;
    unlink)     cmd_unlink ;;
    uninstall)  cmd_uninstall ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help|"") cmd_help ;;
    *) warn "unknown command: $cmd"; cmd_help; exit 1 ;;
esac
