{
  "name": "hosaka-kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "Electron host for the Hosaka terminal and small touchscreen menu.",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "bash scripts/dev.sh",
    "start": "electron .",
    "start:dev": "HOSAKA_KIOSK_URL=http://localhost:5173 HOSAKA_KIOSK_FULLSCREEN=0 HOSAKA_KIOSK_DEVTOOLS=1 electron .",
    "start:server": "HOSAKA_KIOSK_URL=http://127.0.0.1:8421/ electron .",
    "start:windowed": "HOSAKA_KIOSK_FULLSCREEN=0 electron .",
    "build": "cd ../frontend && npm run build"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
