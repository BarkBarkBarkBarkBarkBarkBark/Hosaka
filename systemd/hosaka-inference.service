[Unit]
Description=Hosaka offline inference server
After=network.target ollama.service
Requires=ollama.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=jetson
Group=jetson
WorkingDirectory=/home/jetson/Hosaka
EnvironmentFile=/etc/hosaka/inference.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/jetson/Hosaka/scripts/check-jetson-inference
ExecStart=/home/jetson/Hosaka/.venv/bin/python -m hosaka.server_role
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/hosaka
ReadWritePaths=/var/lib/hosaka-inference
StateDirectory=hosaka-inference
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target