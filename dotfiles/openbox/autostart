#!/bin/sh
# Openbox and LXQt use the same TUI + Menu host supervisor.

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY XAUTHORITY XDG_RUNTIME_DIR 2>/dev/null || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_RUNTIME_DIR 2>/dev/null || true
fi

if command -v xsetroot >/dev/null 2>&1; then
    xsetroot -solid "#0b0b14" 2>/dev/null || true
fi
if command -v xset >/dev/null 2>&1; then
    xset s off -dpms s noblank 2>/dev/null || true
fi
if command -v unclutter >/dev/null 2>&1; then
    unclutter -idle 1 -root >/dev/null 2>&1 &
fi

SUPERVISOR=/usr/local/bin/hosaka-lxqt-kiosk
if [ ! -x "$SUPERVISOR" ]; then
    echo "[hosaka] terminal host supervisor missing: $SUPERVISOR. Rerun appliance setup." >&2
    exit 1
fi
exec "$SUPERVISOR"
