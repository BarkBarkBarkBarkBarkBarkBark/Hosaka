#!/bin/sh
# ~/.xinitrc — Hosaka appliance X session anchor.
#
# Why this file is so plain:
#
# A previous version used `exec xterm` as the session anchor. That meant the
# moment the operator closed the shell window, X exited and the wall went
# black. The Pi appliance hardening packet calls that out explicitly:
#   - Closing shell window must never kill Hosaka GUI.
#   - Provide explicit shell escape separately.
#
# So the rule for this file is:
#
#   - Source /etc/hosaka/env so that PICOCLAW_BIN, HOSAKA_REPO, and the
#     ~/.local/bin PATH are available to children of X.
#   - openbox-session, hosaka-wall, and (optionally) xterm all go to the
#     BACKGROUND. None of them is allowed to be the session anchor.
#   - The session is anchored by `exec tail -f /dev/null`, which keeps X
#     alive until startx itself is signalled. That way the operator can
#     close xterm a hundred times and the Chromium wall just keeps running.
#
# Shell escape stays available via Ctrl+Alt+F2 (kernel VT), which is
# handled at the kernel/console layer and does not depend on this file.

# Soft-coded env so this file works on any host (Pi, Jetson, workstation).
# /etc/hosaka/env is generated by scripts/install_hosaka.sh and contains
# absolute HOSAKA_REPO / HOSAKA_DIRECTORY / PICOCLAW_BIN / PICOCLAW_HOME.
if [ -f /etc/hosaka/env ]; then
    set -a
    . /etc/hosaka/env
    set +a
fi

# Local user overrides win over /etc.
if [ -f "$HOME/.hosaka/env" ]; then
    set -a
    . "$HOME/.hosaka/env"
    set +a
fi

# Screen blanking and the cursor are nuisances on a 7" panel. Best-effort.
xset s off -dpms s noblank 2>/dev/null &
if command -v unclutter >/dev/null 2>&1; then
    unclutter -idle 1 -root >/dev/null 2>&1 &
fi

# Window manager — backgrounded.
openbox-session >>"$HOME/.local/state/openbox.log" 2>&1 &

# Optional convenience shell window. xterm is *optional*; closing it must
# never kill the GUI, which is why it is not the session anchor.
if [ "${HOSAKA_XTERM_PANEL:-0}" = "1" ] && command -v xterm >/dev/null 2>&1; then
    xterm -geometry 80x10+0+0 -title "hosaka-shell" >/dev/null 2>&1 &
fi

# Hosaka wall supervisor — verifies backend + X then launches Chromium.
# Backgrounded; if Chromium exits, hosaka-wall will respawn it without
# killing X. See scripts/hosaka-wall.
mkdir -p "$HOME/.local/state"
if command -v hosaka-wall >/dev/null 2>&1; then
    hosaka-wall start >>"$HOME/.local/state/hosaka-wall.log" 2>&1 &
fi

# Session anchor. NEVER replace this with `exec xterm`, `exec chromium`,
# or `exec hosaka-wall` — see top-of-file rationale.
exec tail -f /dev/null
