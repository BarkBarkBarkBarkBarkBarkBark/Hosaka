[Desktop Entry]
Type=Application
Name=Hosaka
GenericName=Hosaka Field Terminal
Comment=Launch the Hosaka terminal fullscreen on top of the LXQt desktop
Exec=/usr/local/bin/hosaka-lxqt-kiosk
Icon=utilities-terminal
Terminal=false
Categories=System;
Hidden=false
# Only autostart inside the LXQt session. Plain openbox-session has its own
# kiosk supervisor in ~/.config/openbox/autostart, so this would double up.
OnlyShowIn=LXQt;
X-GNOME-Autostart-enabled=true
